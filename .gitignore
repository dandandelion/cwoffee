# Rust
/target
**/*.rs.bk
# NOTE: Cargo.lock is intentionally COMMITTED — cwoffee is an application, not a library.

# Node / frontend
node_modules
ui/dist
ui/.svelte-kit
*.local

# Cwoffee
.cwoffee/
# Turn checkpoints: copies of files a turn overwrote, so the turn can be undone. Runtime
# state in whatever folder the conversation is working in, never a product artifact.
.cws/
*.db
*.db-wal
*.db-shm
assets/working/

# Editor / OS
.idea
.vscode
.DS_Store
*.log
ui/dist/*
!ui/dist/.gitkeep

# spike build output (5 MB binary, never commit)
spike/cwshim

# python helpers (scripts/titlegen.py and friends)
__pycache__/
*.pyc
