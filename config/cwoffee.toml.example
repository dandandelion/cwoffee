# Cwoffee configuration
# Copy to ~/.config/cwoffee/config.toml
#
# Precedence: CLI flag > environment variable > this file > built-in defaults.
# A malformed file is fatal at startup rather than silently ignored — a wrong
# endpoint with no explanation is worse than a crash. A missing file is fine.
#
# Unknown keys are rejected at startup, so do not copy keys from older drafts.
#
# ORDER MATTERS. In TOML a bare key belongs to whichever [table] is currently
# open, so a top-level key written after [provider] parses as provider.workspace
# and silently does nothing. Every top-level key appears below, before the first
# table header.

# ---------------------------------------------------------------------------
# Workspace and approval  (top level - must come before any [table])
# ---------------------------------------------------------------------------
# Where read_file / write_file / exec / download_file operate. A leading ~ is
# expanded. Default: ~/cwoffee-workspace for the desktop app, the process CWD
# for the TUI. Never the GUI's CWD: a window launched by a .desktop file
# inherits one at random.
workspace = "~/cwoffee-workspace"

# ask     - prompt for every tool call
# session - first allow per tool is remembered for the session
# auto    - no prompts; the denylist still applies
mode = "ask"

# Seconds an unanswered approval prompt waits before refusing. Fail closed:
# an unreachable UI must not leave the agent waiting forever.
approval_timeout_secs = 300

# Tokens the model may produce in one round-trip. Thinking and the answer share
# this budget, which is why a small number looks like "it thought and never
# answered". Unset leaves the server's own -np / n_predict in charge. Either way a
# turn that hits the limit is now reported, and the answer is picked back up
# instead of ending mid-sentence.
# max_output_tokens = 8192

theme = "light"               # light | dark | system (not wired up yet)

# ---------------------------------------------------------------------------
# Endpoint
# ---------------------------------------------------------------------------
[provider]
kind     = "llama.cpp"        # llama.cpp | openai | anthropic
base_url = "http://127.0.0.1:8090/v1"
model    = ""                 # empty => adopt the first id from /v1/models
# api_key = "env:CWOFFEE_KEY"   # env:VARNAME keeps secrets off disk

# `kind` selects the wire protocol, not the vendor:
#   llama.cpp  -> OpenAI chat format + chat_template_kwargs.enable_thinking,
#                 reads llama.cpp `timings` for cache/speculative telemetry
#   openai     -> OpenAI chat format, no llama.cpp fields
#   anthropic  -> /v1/messages, thinking blocks, signed-thinking replay

# ---------------------------------------------------------------------------
# Context budget
# ---------------------------------------------------------------------------
# Prefill on a local quantized model is ~30-120 tok/s, so a long transcript is a
# latency problem rather than a correctness one. Compaction is explicit, rare and
# reported — it throws away the server-side prefix cache.
# target_tokens is optional. Unset, the budget is derived from the window the
# endpoint advertises for the loaded model (window * 0.72 - 2048, floor 4096), and
# it is re-derived whenever you switch models. Pin it only to keep transcripts
# short on purpose: a pinned 8000 on a 262k model compacts a 43k conversation and
# then tells you the context is full, which is a lie about the model.
[context]
# target_tokens = 8000
max_tool_output = 8000

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
[search]
# duckduckgo | searxng | auto
#
#   duckduckgo - no setup, no key. Works for the first few queries and then
#                answers with a bot challenge (HTTP 202). Cwoffee reports that as
#                an error you can act on rather than "no results".
#   searxng    - an instance you already run. Needs `formats: [html, json]`
#                enabled in its settings.yml; Cwoffee reads JSON.
#   auto       - Cwoffee runs its own. On the first search it starts a podman (or
#                docker) container bound to 127.0.0.1, with the JSON API on and the
#                bot limiter off, and stops it after it has been idle. Enabling this
#                configures it; setting it back to duckduckgo only disables it - no
#                container is removed, and nothing is uninstalled.
backend = "auto"
max_results = 8
# searxng_url = "http://127.0.0.1:8080/search"
# auto only: the port Cwoffee publishes on. Deliberately not 8888, which is where
# an instance from elsewhere usually already lives; use `searxng` + searxng_url to
# point at one instead.
# auto_port = 8899
# auto only: seconds an unused container is kept before it is stopped.
# auto_idle_secs = 120
# auto only: where settings.yml / limiter.toml are generated. Default is a
# `searxng` directory next to this file, so you can read what was configured.
# auto_dir = "~/.config/cwoffee/searxng"

# ---------------------------------------------------------------------------
# Exec sandbox
# ---------------------------------------------------------------------------
# bwrap is the security boundary. The denylist is a guardrail, not a boundary.
[sandbox]
enabled = true
# Hard ceiling for a command. The model may ask for a shorter deadline per call
# (exec takes an optional "timeout"), but it can never raise this. Anything it
# requests above it is clamped down and the clamp is reported back to the model,
# because a silently clamped deadline just means it keeps asking for longer.
timeout_secs = 120

# ---------------------------------------------------------------------------
# Environment overrides (no config keys - these win over the file)
# ---------------------------------------------------------------------------
#   CWOFFEE_URL, CWOFFEE_MODEL, CWOFFEE_KEY, CWOFFEE_WORKSPACE, CWOFFEE_MODE,
#   CWOFFEE_CONTEXT, CWOFFEE_SEARXNG_URL, CWOFFEE_APPROVAL_TIMEOUT_SECS
